{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/variantprioritization/master/assets/schema_input.json",
    "title": "nf-core/variantprioritization pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "patient": {
                "pattern": "^\\S+$",
                "meta": ["patient"]
            },
            "status": {
                "type": "integer",
                "enum": [0, 1],
                "errorMessage": "Status parameter must be either '0' (Normal) or '1' (Tumor)",
                "meta": ["status"]
            },
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["sample"]
            },
            "sex": {
                "type": "string",
                "description": "The patient's sex",
                "enum": ["MALE", "FEMALE", "UNKNOWN"],
                "default": "UNKNOWN",
                "meta": ["sex"]
            },
            "tumor_site": {
                "type": "integer",
                "description": "Primary tumor type/site code used for site-specific interpretation.",
                "minimum": 0,
                "maximum": 30,
                "errorMessage": "Tumor site must be specified in PCGR's numeric encoding, see https://sigven.github.io/pcgr/articles/running.html#tumor-site",
                "default": 0,
                "meta": ["tumor_site"]
            },
            "tumor_purity": {
                "type": "number",
                "description": "Estimated tumor purity.",
                "minimum": 0,
                "maximum": 1,
                "meta": ["tumor_purity"]
            },
            "tumor_ploidy": {
                "type": "number",
                "description": "Estimated tumor ploidy",
                "exclusiveMinimum": 0,
                "meta": ["tumor_ploidy"]
            },
            "vcf": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.vcf(\\.gz)?$",
                "errorMessage": "VCF file must be provided, cannot contain spaces and must have extension '.vcf' or '.vcf.gz'"
            },
            "cna": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(cns|txt)$",
                "errorMessage": "CNA file cannot contain spaces and must have extension '.cns'"
            }
        },

        "required": ["patient", "status", "sample", "vcf"],
        "allOf": [
            {
                "if": { "properties": { "status": { "const": 0 } } },
                "then": {
                    "$comment": "extra constraints for GERMLINE analysis: illegal columns",
                    "properties": {
                        "tumor_site": false,
                        "tumor_purity": false,
                        "tumor_ploidy": false
                    }
                }
            }
        ]
    }
}
